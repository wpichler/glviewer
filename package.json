{
  "name": "glviewer",
  "productName": "GLViewer",
  "version": "0.1.1",
  "description": "Fast log viewer for systemd journal, local log files and remote hosts via SSH",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --tsconfig tsconfig.node.json --test test/*.test.ts",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:dir": "electron-vite build && electron-builder --linux dir",
    "dist:flatpak": "npm run dist:dir && flatpak run org.flatpak.Builder --user --install --force-clean --disable-rofiles-fuse build-flatpak flatpak/io.github.wpichler.GLViewer.local.yml"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "iconv-lite": "^0.7.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.4.0"
  },
  "desktopName": "io.github.wpichler.GLViewer.desktop",
  "author": {
    "name": "Wolfgang Pichler"
  },
  "homepage": "https://github.com/wpichler/glviewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/wpichler/glviewer.git"
  },
  "bugs": {
    "url": "https://github.com/wpichler/glviewer/issues"
  }
}
